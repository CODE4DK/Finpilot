# Copy to .env and fill in. Only EXPO_PUBLIC_* variables reach the app bundle,
# so never put a service-role key or any other secret in this file.

# Supabase - Project Settings -> API
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# PowerSync - your instance URL
EXPO_PUBLIC_POWERSYNC_URL=https://your-instance.powersync.journeyapps.com

# Google sign-in. These are public client identifiers, not secrets - see
# docs/AUTH_SETUP.md for how to create them. Leave blank to hide the Google
# button on that platform.
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
