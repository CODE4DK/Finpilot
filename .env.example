# Copy to .env and fill in. Only EXPO_PUBLIC_* variables reach the app bundle,
# so never put a service-role key or any other secret in this file.
#
# On EAS these live as environment variables per environment (development,
# preview, production), not in this file - see docs/RELEASE.md. Staging and
# production point at **different Supabase projects**, which is the whole
# point of the split: a test entry must never land in someone's real ledger.

# Which environment this build is. Sentry tags reports with it.
EXPO_PUBLIC_ENVIRONMENT=development

# Supabase - Project Settings -> API
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# PowerSync - your instance URL
EXPO_PUBLIC_POWERSYNC_URL=https://your-instance.powersync.journeyapps.com

# Google sign-in. These are public client identifiers, not secrets - see
# docs/AUTH_SETUP.md for how to create them. Leave blank to hide the Google
# button on that platform.
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# Sentry. The DSN is a public identifier - it only allows *sending* events.
# Leave blank locally: reporting is off in development builds anyway.
EXPO_PUBLIC_SENTRY_DSN=

# --------------------------------------------------------------------------
# Build-time only. Never EXPO_PUBLIC_, never in the bundle. On EAS these are
# secrets; locally you only need them to upload source maps by hand.
# --------------------------------------------------------------------------
# SENTRY_ORG=your-org
# SENTRY_PROJECT=finpilot
# SENTRY_AUTH_TOKEN=
