{
  "name": "finpilot",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "private": true,
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:timezones": "for tz in Asia/Kolkata UTC America/New_York Pacific/Chatham; do echo \"== $tz\"; TZ=$tz jest src/features/ledger/__tests__/period.timezone.test.ts || exit 1; done",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:start": "supabase start",
    "db:reset": "supabase db reset",
    "db:test": "bash scripts/db-test.sh",
    "db:test:local": "bash scripts/db-test.sh finpilot_test",
    "db:types": "node scripts/generate-database-types.mjs"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.1.1",
    "@op-engineering/op-sqlite": "^18.2.4",
    "@powersync/react-native": "^2.2.1",
    "@react-native-community/datetimepicker": "^9.1.0",
    "@shopify/flash-list": "^2.0.2",
    "@supabase/supabase-js": "^2.116.0",
    "expo": "~57.0.24",
    "expo-apple-authentication": "~57.0.2",
    "expo-asset": "~57.0.18",
    "expo-auth-session": "~57.0.12",
    "expo-constants": "~57.0.19",
    "expo-crypto": "~57.0.3",
    "expo-dev-client": "~57.0.19",
    "expo-font": "~57.0.4",
    "expo-linking": "~57.0.10",
    "expo-local-authentication": "~57.0.3",
    "expo-router": "~57.0.22",
    "expo-screen-capture": "~57.0.3",
    "expo-secure-store": "~57.0.4",
    "expo-status-bar": "~57.0.1",
    "expo-web-browser": "~57.0.3",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-get-random-values": "^1.11.0",
    "react-native-reanimated": "^4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "^15.15.4",
