{
  "name": "finpilot",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "private": true,
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "build:dev": "eas build --profile development --platform all",
    "build:preview": "eas build --profile preview --platform all",
    "build:production": "eas build --profile production --platform all",
    "update:preview": "eas update --channel preview",
    "update:production": "eas update --channel production",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:timezones": "for tz in Asia/Kolkata UTC America/New_York Pacific/Chatham; do echo \"== $tz\"; TZ=$tz jest src/features/ledger/__tests__/period.timezone.test.ts src/features/reports/__tests__/periods.test.ts || exit 1; done",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:start": "supabase start",
    "db:reset": "supabase db reset",
    "db:test": "bash scripts/db-test.sh",
    "db:test:local": "bash scripts/db-test.sh finpilot_test",
    "db:types": "node scripts/generate-database-types.mjs"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.1.1",
    "@op-engineering/op-sqlite": "^18.2.4",
    "@powersync/react-native": "^2.2.1",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-native-community/datetimepicker": "^9.1.0",
    "@sentry/react-native": "~7.11.0",
    "@shopify/flash-list": "^2.0.2",
    "@shopify/react-native-skia": "^2.6.2",
    "@supabase/supabase-js": "^2.116.0",
    "expo": "~57.0.24",
    "expo-apple-authentication": "~57.0.2",
    "expo-application": "~57.0.3",
    "expo-asset": "~57.0.18",
    "expo-auth-session": "~57.0.12",
    "expo-constants": "~57.0.19",
    "expo-crypto": "~57.0.3",
    "expo-dev-client": "~57.0.19",
    "expo-device": "~57.0.2",
    "expo-file-system": "~57.0.7",
    "expo-font": "~57.0.4",
    "expo-linking": "~57.0.10",
    "expo-local-authentication": "~57.0.3",
    "expo-notifications": "~57.0.20",
    "expo-router": "~57.0.22",
    "expo-screen-capture": "~57.0.3",
    "expo-secure-store": "~57.0.4",
    "expo-sharing": "~57.0.21",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "expo-updates": "~57.0.23",
    "expo-web-browser": "~57.0.3",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-get-random-values": "^1.11.0",
    "react-native-reanimated": "^4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "^15.15.4",
    "react-native-worklets": "^0.10.1",
    "uuid": "^11.1.1",
    "victory-native": "^42.0.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.2",
    "@types/react": "~19.2.2",
    "babel-plugin-module-resolver": "^5.0.3",
    "babel-preset-expo": "^57.0.12",
    "eslint": "^9.39.5",
    "eslint-config-expo": "^57.0.2",
    "eslint-config-prettier": "^10.1.8",
    "jest": "^29.7.0",
    "jest-expo": "^57.0.5",
    "pg": "^8.23.0",
    "prettier": "^3.9.8",
    "react-dom": "^19.2.3",
    "react-test-renderer": "^19.2.3",
    "supabase": "^2.117.0",
    "typescript": "~6.0.3",
    "zod": "^3.25.76"
  }
