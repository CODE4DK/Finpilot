    "babel-plugin-module-resolver": "^5.0.3",
    "babel-preset-expo": "^57.0.12",
    "eslint": "^9.39.5",
    "eslint-config-expo": "^57.0.2",
    "eslint-config-prettier": "^10.1.8",
    "jest": "^29.7.0",
    "jest-expo": "^57.0.5",
    "pg": "^8.23.0",
    "prettier": "^3.9.8",
    "react-dom": "^19.2.3",
    "react-test-renderer": "^19.2.3",
